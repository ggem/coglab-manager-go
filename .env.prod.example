# Copy to .env alongside docker-compose.prod.yml and fill in real
# values -- never commit the real file (.env/.env.* are gitignored).

# The lab's own local timezone (IANA name) -- required, and validated
# just for presence (not correctness) at startup by cmd/api's requireTZ.
# appointments.schedule_date/schedule_time_start store the lab's local
# wall-clock digits with no timezone attached, and the reminder/digest
# scheduler compares process-local "now" directly against them, so this
# must match where the lab actually is, not where the server happens to
# run.
TZ=America/Denver

# Postgres. DATABASE_URL must agree with the three values below --
# compose doesn't derive one from the other.
POSTGRES_USER=coglab
POSTGRES_PASSWORD=
POSTGRES_DB=coglab
DATABASE_URL=postgres://coglab:REPLACE_ME@postgres:5432/coglab?sslmode=disable

# SMTP relay for invite emails. SMTP_USERNAME/SMTP_PASSWORD may be left
# blank for a relay that needs no authentication. net/smtp.SendMail
# (see internal/mail) only supports opportunistic STARTTLS, not
# implicit TLS on port 465 -- if the relay requires 465, this won't work
# as-is.
SMTP_ADDR=smtp.example.edu:587
SMTP_FROM=noreply@example.edu
SMTP_USERNAME=
SMTP_PASSWORD=

# MCDI (cdibase) backend.
MCDI_API_URL=http://host.docker.internal:8000
MCDI_API_KEY=
MCDI_TYPE_PARAM=

# The frontend's public origin -- used to build invite/password-set
# links, so this must be the real externally-reachable URL.
APP_BASE_URL=https://kelp.colorado.edu
